# Copy this to .env and fill in real values. .env itself should be
# gitignored — never commit a real DATABASE_URL or API_KEY.

# --- Database ---
# Local dev default (no setup needed):
# DATABASE_URL=sqlite:///./gw.db
#
# Real deployment — paste the link your DB teammate gave you. Both of
# these prefixes work (postgres:// gets auto-normalized in app/database.py):
DATABASE_URL=postgresql://postgres.fqwzzzulfogtzhqnbjdv:SIH2026supabase123@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# If your provider's dashboard shows a connection string with
# ?sslmode=require already appended, keep it — don't strip it off.

# --- Auth ---
# Leave empty locally to keep every route open. Set a real value before
# the demo/deploy; then every /stations, /readings, /predict, /alerts
# request needs header: X-API-Key: <this value>. Share this with the
# frontend teammate once it's set — they need to send it on every call.
API_KEY=

# --- Data / model paths (defaults are fine unless you moved the files) ---
CSV_PATH=data/gwl_27stations_final_clean.csv
MODEL_PATH=models/gw_model.json

# --- Alerts ---
ALERT_STD_MULTIPLIER=1.5

# --- CORS ---
CORS_ORIGINS=*
